# Kimai local stack — copy to .env and fill in (the container creates the admin on first boot)
DATABASE_NAME=kimai
DATABASE_USER=kimaiuser
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Regexp of hosts Kimai accepts; any host left out gets a 400 "Bad Request". It must name the
# host in ai-automation's KIMAI_API_BASE_URL (locally host.docker.internal).
TRUSTED_HOSTS=^(localhost|127\.0\.0\.1|host\.docker\.internal)$
# Long random string, e.g. openssl rand -hex 32
APP_SECRET=change-me
# API token for ai-automation (generated in a Kimai user profile / inserted in kimai2_access_token)
KIMAI_API_TOKEN=change-me
# Read-only machine account the ai-automation Kimai↔TL role sync uses. It holds only
# `view_project_roles_api` (never ROLE_ADMIN / edit), so it can READ every project's roles
# but cannot change them. Create it with `kimai:user:create <user> <email> ROLE_ORBIS_SYNC <pass> -n`
# and mint an API token for it in kimai2_access_token.
ORBIS_SYNC_USERNAME=orbis-sync
ORBIS_SYNC_EMAIL=changeme@example.com
ORBIS_SYNC_PASSWORD=change-me
ORBIS_SYNC_API_TOKEN=change-me
