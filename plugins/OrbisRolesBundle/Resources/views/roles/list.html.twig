{% extends 'base.html.twig' %}

{% block main %}
<div class="row">
    <div class="col-md-7">
        {% embed '@theme/embeds/card.html.twig' %}
            {% block box_title %}Roles{% endblock %}
            {% block box_tools %}
                <a class="btn btn-sm btn-primary" href="{{ path('orbis_roles_members') }}">
                    <i class="ti ti-user-check"></i> Assign people
                </a>
            {% endblock %}
            {% block box_body %}
                <table class="table table-striped table-hover">
                    <thead>
                    <tr>
                        <th>Role</th>
                        <th class="text-center">Manages project</th>
                        <th class="text-center">Active</th>
                        <th class="actions"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for r in roles %}
                        <tr>
                            <td><span class="pe-1"><span class="badge me-1" style="background-color:{{ r.color }}"></span>{{ r.name }}</span></td>
                            <td class="text-center"><span class="badge {{ r.manages_project ? 'text-bg-success' : 'text-bg-secondary' }}">{{ r.manages_project ? 'Yes' : 'No' }}</span></td>
                            <td class="text-center"><span class="badge {{ r.active ? 'text-bg-success' : 'text-bg-secondary' }}">{{ r.active ? 'Yes' : 'No' }}</span></td>
                            <td class="actions">
                                <a class="btn btn-link btn-sm" href="{{ path('orbis_roles_admin_toggle', {id: r.id}) }}" title="Toggle manager">
                                    <i class="ti ti-user-check"></i>
                                </a>
                                <a class="btn btn-link btn-sm" href="{{ path('orbis_roles_admin_delete', {id: r.id}) }}" onclick="return confirm('Delete this role?');" title="Delete">
                                    <i class="ti ti-trash"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endblock %}
        {% endembed %}
    </div>
    <div class="col-md-5">
        {% embed '@theme/embeds/card.html.twig' %}
            {% block box_title %}Add role{% endblock %}
            {% block box_body %}
                {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.color) }}
                {{ form_row(form.customColor) }}
                {{ form_row(form.managesProject) }}
                {{ form_row(form.active) }}
                {{ form_row(form.create) }}
                {{ form_end(form) }}
                <script>
                // A custom colour hides the default palette colour closest to it (RGB distance),
                // so two near-identical options never coexist; otherwise all defaults stay.
                document.addEventListener('change', (e) => {
                    if (!(e.target instanceof HTMLInputElement) || e.target.id !== 'form_customColor') return;
                    const custom = (e.target.value || '').replace('#', '');
                    const select = document.getElementById('form_color');
                    if (!select) return;
                    let closest = null, best = 1e9;
                    for (const opt of select.querySelectorAll('option[data-color]')) {
                        const c = (opt.getAttribute('data-color') || '').replace('#', '');
                        const d = colorDist(custom, c);
                        if (d < best) { best = d; closest = opt; }
                    }
                    select.querySelectorAll('option[data-color]').forEach((o) => { o.style.display = ''; });
                    if (closest && best < 60) closest.style.display = 'none';
                });
                function colorDist(a, b) {
                    const r = parseInt(a.slice(0, 2), 16) - parseInt(b.slice(0, 2), 16);
                    const g = parseInt(a.slice(2, 4), 16) - parseInt(b.slice(2, 4), 16);
                    const bl = parseInt(a.slice(4, 6), 16) - parseInt(b.slice(4, 6), 16);
                    return Math.sqrt(r * r + g * g + bl * bl);
                }
                </script>
            {% endblock %}
        {% endembed %}
    </div>
</div>
{% endblock %}